{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/recondiff-snapshot-v1.schema.json",
  "title": "ReconDiff input snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "recondiff.snapshot/v1"
    },
    "assets": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "status",
          "headers"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2048
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "headers": {
            "type": "object",
            "maxProperties": 128,
            "additionalProperties": {
              "type": "string",
              "maxLength": 2048
            },
            "propertyNames": {
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            }
          }
        }
      }
    }
  }
}
